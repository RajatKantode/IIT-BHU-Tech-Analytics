ical variables need numerical representation\n","5. **Scaling**: Features should be on similar scales for many algorithms"],"metadata":{"id":"zCW0psaZIUrs"}},{"cell_type":"code","source":["# Define Haversine Distance Function\n","def haversine_vectorize(lat1, lon1, lat2, lon2):\n","\n","    lon1, lat1, lon2, lat2 = map(np.radians, [lon1, lat1, lon2, lat2])\n","\n","    newlon = lon2 - lon1\n","    newlat = lat2 - lat1\n","\n","    haver_formula = np.sin(newlat/2.0)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(newlon/2.0)**2\n","\n","    dist = 2 * np.arcsin(np.sqrt(haver_formula ))\n","    km = 6367 * dist #6367 for distance in KM for miles use 3958\n","    return km"],"metadata":{"id":"scuYwcqU4VMZ","executionInfo":{"status":"ok","timestamp":1772026327166,"user_tz":-330,"elapsed":8,"user":{"displayName":"Nayan Kantode","userId":"04231590621013628409"}}},"execution_count":16,"outputs":[]},{"cell_type":"code","source":["dist_cols = ['Restaurant_latitude', 'Restaurant_longitude', 'Delivery_location_latitude','Delivery_location_longitude']"],"metadata":{"id":"pdS4MJvL5pNA","executionInfo":{"status":"ok","timestamp":1772026327177,"user_tz":-330,"elapsed":6,"user":{"displayName":"Nayan Kantode","userId":"04231590621013628409"}}},"execution_count":17,"outputs":[]},{"cell_type":"code","source":["df['Distance'] = df[dist_cols].apply(\n","    lambda x: haversine_vectorize(x[0], x[1], x[2], x[3]),\n","    axis=1)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ebxwY7HX6aER","executionInfo":{"status":"ok","timestamp":1772026332002,"user_tz":-330,"elapsed":4819,"user":{"displayName":"Nayan Kantode","userId":"04231590621013628409"}},"outputId":"050dca01-93fe-4e49-a7ae-800e9b54875e"},"execution_count":18,"outputs":[{"output_type":"stream","name":"stderr","text":["/tmp/ipython-input-2342818139.py:2: FutureWarning: Series.__getitem__ treating keys as positions is deprecated. In a future version, integer keys will always be treated as labels (consistent with DataFr